# Copy to .env for local runs. On Vercel, add these in Project Settings > Environment Variables.
# Test keys start with rzp_test_, live keys with rzp_live_. Secrets never go in the website code or in chat.

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Emails to the team (Brevo): API key, a sender address verified in Brevo, and who receives the emails (comma separated)
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_TO=

# Database and staff logins (Supabase, in MedMeal's own account). Project Settings > API.
# SUPABASE_URL and SUPABASE_ANON_KEY are public and safe to show. SUPABASE_SERVICE_ROLE_KEY is secret: Vercel only, never in chat or the code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
